<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MyWeatherApp.ViewModels"
             xmlns:helpers="clr-namespace:MyWeatherApp.Helpers"
             xmlns:models="clr-namespace:MyWeatherApp.Core.Models;assembly=MyWeatherApp.Core"
             xmlns:strings="clr-namespace:MyWeatherApp.Resources.Strings"
             x:DataType="viewmodels:WeatherViewModel"
             x:Class="MyWeatherApp.MainPage"
             Title="{x:Static strings:AppStrings.WeatherForecastAppTitle}"
             Background="{Binding BackgroundBrush}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:LocalizationResourceManager x:Key="Loc" />

            <!-- Layout Converter -->
            <helpers:DailyBoundsConverter x:Key="DailyBoundsConverter" />
            <!-- NEW: Color Logic Converter -->
            <helpers:TemperatureGradientConverter x:Key="TemperatureGradientConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}"
                           Color="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20" RowSpacing="15">

                <!-- Top Bar -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding WeatherData.Timezone}" 
                               TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="{Binding LastUpdatedDisplay}" 
                               TextColor="#E0E0E0" FontSize="12" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="10">
                        <Button Text="EN" Clicked="EnglishButton_Clicked" 
                                BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="20" 
                                HeightRequest="35" Padding="15,0" FontSize="12"/>
                        <Button Text="LT" Clicked="LithuanianButton_Clicked" 
                                BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="20" 
                                HeightRequest="35" Padding="15,0" FontSize="12"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Hero Section -->
                <VerticalStackLayout Grid.Row="1" Spacing="5" HorizontalOptions="Center" Margin="0,20,0,30">
                    <Image HeightRequest="100" WidthRequest="100" Margin="0,0,0,10" HorizontalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{Binding CurrentWeatherIcon}"
                                             FontFamily="FontAwesomeSolid"
                                             Color="White"
                                             Size="100" />
                        </Image.Source>
                        <Image.Shadow>
                            <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.3"/>
                        </Image.Shadow>
                    </Image>

                    <Label Text="{Binding WeatherData.Current.Temperature2m, StringFormat='{0:F0}°'}" 
                           TextColor="White" FontSize="80" FontAttributes="Bold" 
                           HorizontalOptions="Center" LineHeight="0.8"/>

                    <Label Text="{Binding CurrentWeatherDescription}" 
                           TextColor="White" FontSize="24" HorizontalOptions="Center" />

                    <FlexLayout JustifyContent="Center" Wrap="Wrap" Direction="Row" Margin="0,15,0,0">
                        <Label Text="{Binding FeelsLikeDisplay}" TextColor="#E0E0E0" FontAttributes="Bold" Margin="0,0,10,0"/>
                        <Label Text="|" TextColor="#80FFFFFF" Margin="0,0,10,0" />
                        <Label Text="{Binding WindDisplay}" TextColor="#E0E0E0" FontAttributes="Bold" Margin="0,0,10,0"/>
                        <Label Text="|" TextColor="#80FFFFFF" Margin="0,0,10,0" />
                        <Label Text="{Binding HumidityDisplay}" TextColor="#E0E0E0" FontAttributes="Bold"/>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Hourly Forecast -->
                <Border Grid.Row="2" BackgroundColor="#20FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding HourlyForecastTitle}" 
                               TextColor="White" FontAttributes="Bold" FontSize="16" 
                               HorizontalOptions="Center"/>

                        <CollectionView ItemsSource="{Binding HourlyForecast}" HeightRequest="120">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:HourlyForecastItem">
                                    <VerticalStackLayout Spacing="8" WidthRequest="75" VerticalOptions="Center">
                                        <Label Text="{Binding TimeDisplay}" TextColor="#E0E0E0" FontSize="14" HorizontalOptions="Center"/>

                                        <Image HorizontalOptions="Center" HeightRequest="35" WidthRequest="35" Aspect="AspectFit">
                                            <Image.Source>
                                                <FontImageSource Glyph="{Binding Icon}"
                                                                 FontFamily="FontAwesomeSolid"
                                                                 Color="White"
                                                                 Size="24" />
                                            </Image.Source>
                                        </Image>

                                        <Label Text="{Binding Temperature, StringFormat='{0:F0}°'}" TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>

                                        <Label Text="{Binding PrecipitationChance, StringFormat='{0}%'}" 
                                               TextColor="#A0FFFFFF" FontSize="12" HorizontalOptions="Center"
                                               IsVisible="{Binding PrecipitationChance, Converter={StaticResource InverseBoolConverter}}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- 7-Day Forecast -->
                <Border Grid.Row="3" BackgroundColor="#20FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding DailyForecastTitle}" 
                               TextColor="White" FontAttributes="Bold" FontSize="16" Margin="0,0,0,5"
                               HorizontalOptions="Center"/>

                        <CollectionView ItemsSource="{Binding DailyForecast}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DailyForecastItem">
                                    <Grid ColumnDefinitions="50, 120, *, Auto" Padding="0,12" ColumnSpacing="5">

                                        <Image Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource Glyph="{Binding WeatherIcon}"
                                                                 FontFamily="FontAwesomeSolid"
                                                                 Color="White"
                                                                 Size="20" />
                                            </Image.Source>
                                        </Image>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding DayOfWeek}" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                            <Label Text="{Binding WeatherDescription}" TextColor="#D0D0D0" FontSize="12" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>

                                        <!-- 3. Temperature Bar -->
                                        <ContentView Grid.Column="2" VerticalOptions="Center" Padding="10,0">
                                            <AbsoluteLayout HeightRequest="6">
                                                <!-- Track Background -->
                                                <BoxView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" 
                                                         Color="#30000000" CornerRadius="3"/>

                                                <!-- Filled Range Bar -->
                                                <!-- 1. LayoutBounds via DailyBoundsConverter -->
                                                <!-- 2. Background Brush via TemperatureGradientConverter -->
                                                <BoxView AbsoluteLayout.LayoutBounds="{Binding ., Converter={StaticResource DailyBoundsConverter}}" 
                                                         AbsoluteLayout.LayoutFlags="All" 
                                                         Background="{Binding ., Converter={StaticResource TemperatureGradientConverter}}"
                                                         CornerRadius="3" />
                                            </AbsoluteLayout>
                                        </ContentView>

                                        <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                                            <Label Text="{Binding MaxTemp, StringFormat='{0:F0}°'}" TextColor="White" FontAttributes="Bold" FontSize="16" WidthRequest="30" HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding MinTemp, StringFormat='{0:F0}°'}" TextColor="#A0FFFFFF" FontSize="16" WidthRequest="30" HorizontalTextAlignment="End"/>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>